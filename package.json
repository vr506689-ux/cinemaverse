{
  "name": "cinemaverse",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "CINEMAVERSE - a free, browser-based multiplayer 3D virtual cinema (Phase 1: foundation)",
  "scripts": {
    "dev": "concurrently -k -n game,server -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "4.21.2",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18.18"
  }
}